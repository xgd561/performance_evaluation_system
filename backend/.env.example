# =============================================================
# 绩效考核系统 - 后端环境配置示例
# 复制此文件为 .env 并按实际情况填写。
# .env 文件已在 .gitignore 中排除，请勿将真实密钥提交到版本库。
# =============================================================

# JWT 配置
# JWT_SECRET_KEY：用于签名 JWT 的密钥，生产环境请使用至少 32 字符的随机字符串
# 生成示例（Python）：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=please-change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库配置
# 留空则使用默认路径：<项目根>/data/db/performance_evaluation.db
# 如需自定义，填写完整 SQLite URL，例如：sqlite:///D:/mydata/perf.db
DATABASE_URL=
